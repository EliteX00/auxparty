{
  "rewrites": [
    {
      "source": "/api/search",
      "destination": "/api/search.js"
    },
    {
      "source": "/api/trending",
      "destination": "/api/trending.js"
    },
    {
      "source": "/api/spotify/playlist",
      "destination": "/api/spotify.js"
    },
    {
      "source": "/api/recommendations",
      "destination": "/api/recommendations.js"
    },
    {
      "source": "/api/youtube",
      "destination": "/api/youtube.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
